{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "synagogue_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d1\u05d9\u05ea \u05d4\u05db\u05e0\u05e1\u05ea"
    },
    "logo_url": {
      "type": "string",
      "description": "URL \u05dc\u05d5\u05d2\u05d5 \u05d1\u05d9\u05ea \u05d4\u05db\u05e0\u05e1\u05ea"
    },
    "synagogue_city": {
      "type": "string",
      "description": "\u05e2\u05d9\u05e8 \u05d1\u05d9\u05ea \u05d4\u05db\u05e0\u05e1\u05ea"
    },
    "synagogue_timezone": {
      "type": "string",
      "description": "\u05d0\u05d6\u05d5\u05e8 \u05d6\u05de\u05df",
      "default": "Asia/Jerusalem"
    },
    "prayer_calculation_method": {
      "type": "string",
      "description": "\u05e9\u05d9\u05d8\u05ea \u05d7\u05d9\u05e9\u05d5\u05d1 \u05d6\u05de\u05e0\u05d9\u05dd",
      "enum": [
        "MGA",
        "GRA",
        "FIXED_LOCAL"
      ],
      "default": "GRA"
    },
    "prayer_times": {
      "type": "array",
      "description": "\u05d6\u05de\u05e0\u05d9 \u05ea\u05e4\u05d9\u05dc\u05d5\u05ea",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "fixed",
              "relative"
            ]
          },
          "fixed_time": {
            "type": "string"
          },
          "relative_anchor": {
            "type": "string"
          },
          "relative_offset_minutes": {
            "type": "number"
          },
          "relative_direction": {
            "type": "string",
            "enum": [
              "before",
              "after"
            ]
          },
          "days": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "every_day": {
            "type": "boolean"
          }
        }
      }
    }
  }
}